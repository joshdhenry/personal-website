# Copy this file to .env.deploy and fill in your values.
# .env.deploy is gitignored — never commit real hosting credentials.

DEPLOY_SSH_HOST=your-server-hostname.example.com
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=your-cpanel-username
DEPLOY_SSH_KEY=$HOME/.ssh/your-deploy-key
DEPLOY_REMOTE_PATH=public_html
DEPLOY_SITE_URL=https://your-site.example.com
